# Copy to .env.local and fill in. Validated in src/lib/env.ts.

# Public (inlined into the browser bundle at build time)
NEXT_PUBLIC_SITE_URL=http://localhost:4747
# The store's name in titles, the header, consent and sign-up copy
# (src/lib/brand.ts). Empty = "Store".
NEXT_PUBLIC_STORE_NAME=
# The name in the header and on the home page, if it differs. Empty = the
# store's name.
NEXT_PUBLIC_SITE_NAME=
# Prefixes the source of a Klaviyo email sign-up ("<prefix> footer").
# Empty = the store's name.
NEXT_PUBLIC_SOURCE_PREFIX=
# Prefix for the site's own cookies (cart, customer session, consent,
# country; src/lib/cookie-names.ts). Letters, digits, _ or -, starting with
# a letter. Empty = store_. Changing it on a live site empties carts and
# signs customers out.
NEXT_PUBLIC_COOKIE_PREFIX=
# Google Tag Manager container (GTM-XXXXXXX). Empty = no GTM, no Consent Mode.
NEXT_PUBLIC_GTM_ID=
# Klaviyo public key (6 characters), for klaviyo.js only. Empty = no klaviyo.js.
NEXT_PUBLIC_KLAVIYO_SITE_ID=
# Free-shipping threshold shown in the cart (e.g. 50.00). Mirror the Shopify shipping rate. Empty = no progress bar.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=
# Attentive brand tag (cdn.attn.tv/<brand>/dtag.js). Empty = no Attentive.
NEXT_PUBLIC_ATTENTIVE_BRAND=

# Server only
# Judge.me private API token (reviews). Server only.
JUDGEME_PRIVATE_TOKEN=
# Turns on the shop pages and the Shop nav link; off = they 404. Read at build time, so redeploy after changing.
SHOP_ENABLED=false
# Launch: lets search engines index the shop and adds it to the sitemap.
SHOP_INDEXED=false
# Klaviyo private key (pk_...): the newsletter form and back-in-stock alerts
# (Notify me). Scopes: lists:write, profiles:write, subscriptions:write,
# catalogs:write. Empty = neither.
KLAVIYO_PRIVATE_API_KEY=
# The list marketing sign-ups join: the newsletter form, and Notify me's
# optional "also email me" choice. Empty = no newsletter form and no
# opt-in (Notify me alerts still work with the key alone).
KLAVIYO_LIST_ID=

# Shopify (Headless channel). Only needed when the shop is on; checked on the
# first Shopify call. Domain is the *.myshopify.com host, no https://.
SHOPIFY_STORE_DOMAIN=
# Private Storefront API token. Server only.
SHOPIFY_PRIVATE_ACCESS_TOKEN=
# The store's checkout domain once it has one (e.g. checkout.example.com,
# no https://): Buy with Shop Pay redirects there, so the Content Security
# Policy allows it. Required with CSP_ENFORCE=1.
SHOPIFY_CHECKOUT_DOMAIN=
# Verifies Shopify webhooks (cache refresh). Unset = webhooks are refused.
SHOPIFY_WEBHOOK_SECRET=
# Refreshes the Shopify menus at once (Shopify sends no webhook for menu
# edits; they refresh hourly otherwise): POST /api/revalidate/menus with
# "Authorization: Bearer <secret>". At least 32 characters. Unset = 404.
MENUS_REVALIDATE_SECRET=
# 1 = enforce the Content Security Policy (read at build). Empty = report
# only (violations go to /api/csp-report). See src/lib/security/headers.ts.
CSP_ENFORCE=
# Shopify browser analytics and the same-origin Storefront API proxy.
# Public token (browser-safe) and the Headless channel's storefront id.
NEXT_PUBLIC_SHOPIFY_PUBLIC_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ID=
# Customer accounts: the Customer Account API client id (Headless channel)
# and a secret of 32+ characters that encrypts the session cookie
# (e.g. openssl rand -base64 48). Either empty = accounts off.
SHOPIFY_CUSTOMER_CLIENT_ID=
CUSTOMER_ACCOUNT_SESSION_SECRET=

# Manual QA only: the password-protected dev store's storefront password,
# for viewing the store in a browser. The app and tests never read it, and
# the build fails if it appears in client output.
SHOPIFY_STOREFRONT_PASSWORD=
