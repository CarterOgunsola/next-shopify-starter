{
  "name": "next-shopify-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 4747",
    "build": "next build && node scripts/check-client-secrets.mjs",
    "start": "next start -p 4747",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && pnpm gql:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "prettier --check . && eslint && pnpm typecheck && vitest run",
    "gate:build": "pnpm gate && pnpm build",
    "gql:check": "hydrogen gql check --fail-on-warn",
    "fixtures:record": "vitest run --config vitest.record.config.mts",
    "test:e2e": "playwright test --project=chromium --project=mobile",
    "perf": "playwright test --project=perf --workers=1",
    "test:e2e:csp": "CSP_ENFORCE=1 playwright test --project=chromium --project=mobile",
    "tunnel": "node scripts/tunnel.mjs",
    "launch:check": "LAUNCH_CHECK=1 vitest run src/lib/commerce/compliance.test.ts",
    "test:live": "VITEST_LIVE=1 vitest run --config vitest.record.config.mts",
    "dev:https": "next dev --experimental-https --hostname local.tryhydrogen.dev -p 4747",
    "cf:build": "HOSTING=cloudflare opennextjs-cloudflare build && node scripts/cloudflare-assets.mjs",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "CF_DEPLOY=1 pnpm cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@c15t/nextjs": "2.2.1",
    "@shopify/hydrogen": "2026.10.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "graphql": "17.0.2",
    "jsdom": "30.1.1",
    "msw": "3.0.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.1",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@10.28.2"
}
